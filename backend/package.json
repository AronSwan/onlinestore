{
  "type": "commonjs",
  "name": "caddy-style-shopping-backend",
  "version": "1.0.0",
  "description": "基于 CongoMall 设计的购物网站后端服务",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" \"scripts/**/*.{js,ts}\" --fix",
    "lint:app": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:scripts": "eslint \"scripts/**/*.{js,ts}\" --fix",
    "typecheck": "tsc -p tsconfig.json --pretty",
    "typecheck:spec": "tsc -p tsconfig.spec.json --pretty",
    "typecheck:build": "tsc -p tsconfig.build.json --pretty",
    "test": "jest --config=jest.config.cjs",
    "test:silent": "jest --config=jest.config.cjs --silent",
    "test:unit": "jest --config=jest.config.unit.cjs",
    "test:component": "jest --config=jest.config.cjs --testPathPattern=src/.*\\.(component\\.spec|component\\.test)\\.ts$",
    "test:e2e": "jest --config=jest.config.e2e.cjs",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "test:cov": "jest --config=jest.config.cjs --coverage",
    "test:cov:soft": "node ./node_modules/jest/bin/jest.js --config=jest.soft.config.cjs --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:ci:jest": "jest --config=jest.config.cjs --coverage --ci",
    "test:parallel": "jest --config=jest.config.cjs",
    "test:monitor": "jest --config=jest.config.cjs --detectOpenHandles",
    "test:secure": "jest --config=jest.config.cjs --detectOpenHandles",
    "test:legacy": "jest --config=jest.config.cjs",
    "test:idle": "jest --config=jest.config.cjs --runInBand",
    "test:smart": "jest --config=jest.config.cjs",
    "test:analysis": "jest --config=jest.config.cjs --listTests",
    "test:validate": "jest --help",
    "security:heatmap:jest": "jest scripts/generate-risk-heatmap.test.js",
    "security:full-check": "npm run security:validate-constants && npm run security:validate-data && npm run security:check:optimized",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/typeorm.config.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/typeorm.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/typeorm.config.ts",
    "upgrade:tools": "npm install --save-dev npm-check-updates@16.0.0 npm-check@0.0.1 depcheck@1.4.0 --legacy-peer-deps",
    "upgrade:analyze": "npm outdated && npx depcheck && npx npm-check --graph",
    "upgrade:update": "npx npm-check-updates --interactive -u",
    "upgrade:install": "npm install --legacy-peer-deps",
    "upgrade:test": "npm run test",
    "upgrade:security": "npm audit",
    "upgrade:fix-deps": "npm audit fix --legacy-peer-deps",
    "config:generate": "copy .env.master .env.example"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "bull": "^4.16.5",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.9",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "js-yaml": "^4.1.1",
    "protobufjs": "^7.6.5"
  }
}
