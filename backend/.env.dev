# 开发环境配置文件

# 数据库配置
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DB_DATABASE=shopping_db

# JWT 配置
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_inject_via_secret_manager

# OpenObserve 配置（设置为本地地址或禁用）
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_USERNAME=admin@example.com
OPENOBSERVE_PASSWORD=CHANGE_ME_OPENOBSERVE_PASSWORD

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# 应用配置
NODE_ENV=development
PORT=3000
API_PREFIX=api

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# 日志配置
LOG_LEVEL=debug

# 加密配置（64字符长度）
ENCRYPTION_KEY=CHANGE_ME_encryption_key_32_bytes_hex___________________________